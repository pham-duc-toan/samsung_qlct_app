<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Budget -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/budget_section" />

        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_budget"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsBubble"
                        android:backgroundTint="@color/primary"
                        android:src="@drawable/ic_wallet" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/budget_title" />

                        <TextView
                            android:id="@+id/tv_budget_value"
                            style="@style/SettingsSubtitle"
                            tools:text="5.000.000 đ" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_category_budget"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsBubble"
                        android:backgroundTint="@color/cat_bills"
                        android:src="@drawable/ic_category" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/category_budget_title" />

                        <TextView
                            style="@style/SettingsSubtitle"
                            android:text="@string/category_budget_subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Appearance -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/appearance" />

        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">

            <LinearLayout
                android:id="@+id/row_theme"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsBubble"
                    android:backgroundTint="@color/cat_home"
                    android:src="@drawable/ic_palette" />

                <LinearLayout style="@style/SettingsRowText">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/appearance" />

                    <TextView
                        android:id="@+id/tv_theme_value"
                        style="@style/SettingsSubtitle"
                        tools:text="Theo hệ thống" />
                </LinearLayout>

                <ImageView style="@style/SettingsChevron" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Reminder -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/reminder_section" />

        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">

            <LinearLayout
                android:id="@+id/row_reminder"
                style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsBubble"
                    android:backgroundTint="@color/warning"
                    android:src="@drawable/ic_bell" />

                <LinearLayout style="@style/SettingsRowText">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/reminder_title" />

                    <TextView
                        android:id="@+id/tv_reminder_value"
                        style="@style/SettingsSubtitle"
                        tools:text="Nhắc lúc 20:00" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Data -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/data_section" />

        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_export"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsBubble"
                        android:backgroundTint="@color/secondary"
                        android:src="@drawable/ic_export" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/export_csv" />

                        <TextView
                            style="@style/SettingsSubtitle"
                            android:text="@string/export_subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_delete_all"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsBubble"
                        android:backgroundTint="@color/expense"
                        android:src="@drawable/ic_delete" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/delete_all" />

                        <TextView
                            style="@style/SettingsSubtitle"
                            android:text="@string/delete_all_subtitle" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- About -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/about" />

        <androidx.cardview.widget.CardView
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    style="@style/SettingsBubble"
                    android:backgroundTint="@color/cat_invest"
                    android:src="@drawable/ic_info" />

                <TextView
                    style="@style/SettingsTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/about_value" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
